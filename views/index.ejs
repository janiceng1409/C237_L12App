<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Music App</title>
</head>

<body class="bg-dark text-white">

    <%- include('partials/navbar') %>

    <div class="container mt-4">

        <h1 class="mb-4">Browse Songs</h1>

        <!-- Search Bar -->
        <input
            type="text"
            id="searchInput"
            class="form-control mb-4"
            placeholder="Search songs..."
        >

        <div class="row" id="songContainer">

            <% songs.forEach(song => { %>

                <div class="col-md-4 mb-4 song-card">

                    <div class="card bg-secondary text-white h-100">

                        <img src="<%= song.image %>" class="card-img-top">

                        <div class="card-body">

                            <h5 class="song-title"><%= song.title %></h5>

                            <p><%= song.artist %></p>

                            <form action="/favourite/<%= song.id %>" method="POST">

                                <button class="btn btn-success w-100">
                                    Add to Favourites
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

    <!-- Search Function -->
    <script>

        const searchInput = document.getElementById('searchInput');

        searchInput.addEventListener('keyup', function () {

            const filter = searchInput.value.toLowerCase();

            const songs = document.querySelectorAll('.song-card');

            songs.forEach(song => {

                const title = song.querySelector('.song-title')
                    .textContent
                    .toLowerCase();

                if (title.includes(filter)) {
                    song.style.display = 'block';
                }
                else {
                    song.style.display = 'none';
                }

            });

        });

    </script>

</body>
</html>